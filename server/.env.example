# --- Servidor ---
PORT=3000
NODE_ENV=development
# Origen permitido si sirves el frontend desde otro dominio (déjalo vacío si Express sirve /public)
CORS_ORIGIN=

# --- Base de datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mexia
DB_PASSWORD=cambia_esto
DB_NAME=mexia

# --- Seguridad ---
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
SESSION_HOURS=12
# true en producción (HTTPS). En local con http deja false.
COOKIE_SECURE=false

# --- Archivos ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=8

